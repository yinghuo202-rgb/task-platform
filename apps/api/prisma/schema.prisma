generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectKind {
  GENERAL
  COMPANION
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  CLAIMED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  DISPUTED
  REMOVED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum EntryType {
  JOURNAL
  REVIEW
}

enum ClaimMode {
  AUTO
  APPROVAL
}

enum RewardType {
  POINTS
  CASH_OFFLINE
  ITEM
  SERVICE
  OTHER
}

enum RewardFulfillmentStatus {
  NOT_APPLICABLE
  PENDING
  CONFIRMED
  DISPUTED
}

enum LocationType {
  REMOTE
  ONSITE
  HYBRID
  UNSPECIFIED
}

enum TaskTimeMode {
  BEFORE
  WITHIN
  AT
}

enum TaskTimeUnit {
  MINUTES
  HOURS
  DAYS
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

enum NotificationType {
  TASK_PUBLISHED
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  TASK_ASSIGNED
  SUBMISSION_RECEIVED
  REVISION_REQUESTED
  TASK_COMPLETED
  TASK_CANCELLED
  TASK_DISPUTED
  SYSTEM
}

enum CalendarSubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(32)
  email        String     @unique @db.VarChar(254)
  passwordHash String
  displayName  String     @db.VarChar(64)
  avatarPath   String?
  bio          String?    @db.VarChar(1000)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  lastLoginAt  DateTime?  @db.Timestamptz(3)

  sessions     AuthSession[]
  createdProjects Project[]        @relation("CreatedProjects")
  projectMemberships ProjectMember[]
  tasks        Task[]            @relation("PublishedTasks")
  applications TaskApplication[]
  assignments  TaskAssignment[]
  submissions  TaskSubmission[]
  comments     TaskComment[]
  notifications Notification[]
  auditLogs    AuditLog[]
  calendarEvents CalendarEvent[]
  outgoingCalendarSubscriptions CalendarSubscription[] @relation("CalendarSubscriber")
  incomingCalendarSubscriptions CalendarSubscription[] @relation("CalendarOwner")
  createdEntries Entry[]        @relation("EntryCreatedBy")
  updatedEntries Entry[]        @relation("EntryUpdatedBy")
  entryVersions  EntryVersion[] @relation("EntryVersionCreatedBy")
  entryComments  EntryComment[]
  createdSharedWishes   SharedWish[] @relation("SharedWishCreatedBy")
  completedSharedWishes SharedWish[] @relation("SharedWishCompletedBy")

  @@map("users")
}

model CalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(1000)
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  allDay      Boolean  @default(false)
  color       String   @default("#7f66ff") @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, startsAt])
  @@index([userId, endsAt])
  @@map("calendar_events")
}

model Entry {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @db.Uuid
  type            EntryType    @default(JOURNAL)
  title           String       @db.VarChar(160)
  contentMarkdown String       @db.Text
  entryDate       DateTime     @db.Date
  rating          Decimal?     @db.Decimal(2, 1)
  category        String?      @db.VarChar(60)
  tags            String[]     @default([])
  visibility      Visibility   @default(PRIVATE)
  status          String       @default("PUBLISHED") @db.VarChar(20)
  createdById     String       @db.Uuid
  updatedById     String       @db.Uuid
  importedPath    String?      @db.VarChar(500)
  importHash      String?      @db.VarChar(128)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  version         Int          @default(1)

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User         @relation("EntryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions        EntryVersion[]
  comments        EntryComment[]

  @@index([entryDate, id])
  @@index([projectId, entryDate])
  @@index([type, entryDate])
  @@index([visibility, entryDate])
  @@unique([importedPath, importHash])
  @@map("entries")
}

model EntryVersion {
  id              String   @id @default(uuid()) @db.Uuid
  entryId         String   @db.Uuid
  version         Int
  title           String   @db.VarChar(160)
  contentMarkdown String   @db.Text
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  entry            Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdBy        User     @relation("EntryVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([entryId, version])
  @@index([entryId, createdAt])
  @@map("entry_versions")
}

model EntryComment {
  id          String    @id @default(uuid()) @db.Uuid
  entryId     String    @db.Uuid
  authorId    String    @db.Uuid
  content     String    @db.VarChar(1200)
  anchorBlock Int?
  anchorQuote String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  entry  Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([authorId])
  @@map("entry_comments")
}

model CalendarSubscription {
  id           String                     @id @default(uuid()) @db.Uuid
  subscriberId String                     @db.Uuid
  ownerId      String                     @db.Uuid
  status       CalendarSubscriptionStatus @default(PENDING)
  respondedAt  DateTime?                  @db.Timestamptz(3)
  createdAt    DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                   @updatedAt @db.Timestamptz(3)

  subscriber User @relation("CalendarSubscriber", fields: [subscriberId], references: [id], onDelete: Restrict)
  owner      User @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([subscriberId, ownerId])
  @@index([ownerId, status])
  @@index([subscriberId, status])
  @@map("calendar_subscriptions")
}

model AuthSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String
  csrfToken        String
  userAgent        String?  @db.VarChar(500)
  ipAddress        String?  @db.VarChar(64)
  expiresAt        DateTime @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  creatorId   String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(2000)
  color       String   @default("#3157f6") @db.VarChar(20)
  kind        ProjectKind @default(GENERAL)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  creator User            @relation("CreatedProjects", fields: [creatorId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks   Task[]
  entries Entry[]
  sharedWishes SharedWish[]

  @@index([creatorId])
  @@index([archivedAt])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model SharedWish {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  title         String    @db.VarChar(500)
  position      Int       @default(0)
  sourceKey     String?   @db.VarChar(100)
  createdById   String    @db.Uuid
  completedById String?   @db.Uuid
  completedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy   User    @relation("SharedWishCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?   @relation("SharedWishCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([projectId, sourceKey])
  @@index([projectId, completedAt, position])
  @@map("shared_wishes")
}

model Task {
  id                      String                  @id @default(uuid()) @db.Uuid
  projectId               String                  @db.Uuid
  publisherId             String                  @db.Uuid
  title                   String                  @db.VarChar(120)
  summary                 String                  @db.VarChar(300)
  description             String                  @db.Text
  category                String                  @db.VarChar(50)
  status                  TaskStatus              @default(DRAFT)
  visibility              Visibility              @default(PUBLIC)
  shareToken              String                  @unique @default(uuid()) @db.Uuid
  claimMode               ClaimMode
  maxAssignees            Int                     @default(1)
  rewardType              RewardType
  rewardAmount            Decimal?                @db.Decimal(18, 2)
  rewardDescription       String?                 @db.VarChar(500)
  rewardOptions           String[]                @default([])
  rewardFulfillmentStatus RewardFulfillmentStatus @default(NOT_APPLICABLE)
  locationType            LocationType
  locationDescription     String?                 @db.VarChar(500)
  timeMode                 TaskTimeMode            @default(BEFORE)
  durationValue            Int?
  durationUnit             TaskTimeUnit?
  deadline                DateTime?                @db.Timestamptz(3)
  publishedAt             DateTime?                @db.Timestamptz(3)
  completedAt             DateTime?                @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  version                 Int                     @default(1)

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  publisher  User                   @relation("PublishedTasks", fields: [publisherId], references: [id], onDelete: Restrict)
  requirements TaskRequirement[]
  attachments TaskAttachment[]
  applications TaskApplication[]
  assignments TaskAssignment[]
  submissions TaskSubmission[]
  comments TaskComment[]
  notifications Notification[]

  @@index([projectId])
  @@index([publisherId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([deadline])
  @@map("tasks")
}

model TaskRequirement {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  title       String   @db.VarChar(100)
  description String   @db.VarChar(2000)
  required    Boolean  @default(true)
  sortOrder   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, sortOrder])
  @@map("task_requirements")
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  uploaderId   String   @db.Uuid
  originalName String   @db.VarChar(255)
  storageName  String   @unique @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@map("task_attachments")
}

model TaskApplication {
  id          String            @id @default(uuid()) @db.Uuid
  taskId      String            @db.Uuid
  applicantId String            @db.Uuid
  message     String            @db.VarChar(2000)
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  decidedAt   DateTime?         @db.Timestamptz(3)
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  assignment  TaskAssignment?
  attachments ApplicationAttachment[]

  @@index([taskId])
  @@index([applicantId])
  @@map("task_applications")
}

model ApplicationAttachment {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  uploaderId    String          @db.Uuid
  originalName  String          @db.VarChar(255)
  storageName   String          @unique @db.VarChar(255)
  mimeType      String          @db.VarChar(100)
  size          Int
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  application   TaskApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@map("application_attachments")
}

model TaskAssignment {
  id            String           @id @default(uuid()) @db.Uuid
  taskId        String           @db.Uuid
  assigneeId    String           @db.Uuid
  applicationId String?          @unique @db.Uuid
  status        AssignmentStatus @default(ASSIGNED)
  assignedAt    DateTime         @default(now()) @db.Timestamptz(3)
  dueAt         DateTime?        @db.Timestamptz(3)
  startedAt     DateTime?        @db.Timestamptz(3)
  completedAt   DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  assignee      User             @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  application   TaskApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([taskId, assigneeId])
  @@index([taskId])
  @@index([assigneeId])
  @@map("task_assignments")
}

model TaskSubmission {
  id            String           @id @default(uuid()) @db.Uuid
  taskId        String           @db.Uuid
  submitterId   String           @db.Uuid
  content       String           @db.Text
  status        SubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime         @default(now()) @db.Timestamptz(3)
  reviewedAt    DateTime?        @db.Timestamptz(3)
  reviewMessage String?          @db.VarChar(2000)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  submitter     User             @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  attachments   SubmissionAttachment[]

  @@index([taskId, submittedAt])
  @@map("task_submissions")
}

model SubmissionAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @db.Uuid
  uploaderId   String         @db.Uuid
  originalName String         @db.VarChar(255)
  storageName  String         @unique @db.VarChar(255)
  mimeType     String         @db.VarChar(100)
  size         Int
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@map("submission_attachments")
}

model TaskComment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String    @db.Uuid
  content   String    @db.VarChar(5000)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  taskId     String?          @db.Uuid
  targetPath String?          @db.VarChar(500)
  type       NotificationType
  title      String           @db.VarChar(200)
  content    String           @db.VarChar(1000)
  readAt     DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
