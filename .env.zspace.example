# 极空间 Intel NAS 示例。复制为 .env 后，替换镜像地址、密钥、NAS IP 和数据路径。
APP_ENV=production
APP_PLATFORM=linux/amd64
APP_PORT=3001
WEB_PORT=3000
PUBLIC_PORT=8081

# 官方在线更新镜像；固定版本便于备份和回滚。
PROXY_IMAGE=ghcr.io/yinghuo202-rgb/task-platform-proxy:v1.2.6
WEB_IMAGE=ghcr.io/yinghuo202-rgb/task-platform-web:v1.2.6
API_IMAGE=ghcr.io/yinghuo202-rgb/task-platform-api:v1.2.6
POSTGRES_IMAGE=postgres:17.5-bookworm
IMAGE_PULL_POLICY=missing

POSTGRES_DB=task_platform
POSTGRES_USER=task_platform
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://task_platform:replace_with_the_same_url_encoded_password@db:5432/task_platform

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
REGISTRATION_INVITE_CODE=replace_with_a_private_invite_code
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PUBLIC_APP_URL=http://192.168.0.164:8081
ALLOWED_ORIGINS=
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=1

UPLOAD_DIR=/data/uploads
JOURNAL_IMPORT_DIR=/data/journal-import
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=10

# 相对路径会落在 Compose 项目目录内，可避开极空间对显示路径的校验差异。
POSTGRES_DATA_PATH=./data/postgres
UPLOAD_DATA_PATH=./data/uploads
JOURNAL_IMPORT_PATH=./data/journal-import
BACKUP_DATA_PATH=./data/backups
