# NAS 生产模板：复制为 .env 后再替换镜像仓库、密钥、NAS 地址和目录。
APP_ENV=production
APP_PORT=3001
WEB_PORT=3000
PUBLIC_PORT=8080
APP_PLATFORM=linux/amd64

# NAS 只拉取/导入镜像，不在设备上构建源码。使用固定版本，不使用 latest。
PROXY_IMAGE=registry.example.com/team/task-platform-proxy:1.0.0
WEB_IMAGE=registry.example.com/team/task-platform-web:1.0.0
API_IMAGE=registry.example.com/team/task-platform-api:1.0.0
POSTGRES_IMAGE=postgres:17.5-bookworm
IMAGE_PULL_POLICY=missing

POSTGRES_DB=task_platform
POSTGRES_USER=task_platform
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://task_platform:replace_with_a_long_random_password@db:5432/task_platform

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
REGISTRATION_INVITE_CODE=replace_with_a_private_invite_code
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 改成 NAS 的局域网地址或 HTTPS 域名。
PUBLIC_APP_URL=http://192.168.1.10:8080
ALLOWED_ORIGINS=
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=1

UPLOAD_DIR=/data/uploads
JOURNAL_IMPORT_DIR=/data/journal-import
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=10

# 群晖示例；QNAP/TrueNAS 请替换为其真实绝对路径。
POSTGRES_DATA_PATH=/volume1/docker/task-platform/data/postgres
UPLOAD_DATA_PATH=/volume1/docker/task-platform/data/uploads
JOURNAL_IMPORT_PATH=/volume1/docker/task-platform/data/journal-import
BACKUP_DATA_PATH=/volume1/docker/task-platform/data/backups
BACKUP_RETENTION_DAYS=30
