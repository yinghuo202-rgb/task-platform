APP_ENV=production
APP_PORT=3001
WEB_PORT=3000
PUBLIC_PORT=8080
APP_PLATFORM=linux/amd64

# 生产 Compose 只运行镜像，不在 NAS 上编译源码。
# 使用镜像仓库时请替换为完整地址，例如 registry.example.com/team/task-platform-web:1.0.0。
PROXY_IMAGE=task-platform-proxy:1.0.0
WEB_IMAGE=task-platform-web:1.0.0
API_IMAGE=task-platform-api:1.0.0
POSTGRES_IMAGE=postgres:17.5-bookworm
IMAGE_PULL_POLICY=missing

POSTGRES_DB=task_platform
POSTGRES_USER=task_platform
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://task_platform:replace_with_a_long_random_password@db:5432/task_platform

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
REGISTRATION_INVITE_CODE=replace_with_a_private_invite_code
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PUBLIC_APP_URL=http://localhost:8080
ALLOWED_ORIGINS=
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=1

UPLOAD_DIR=/data/uploads
JOURNAL_IMPORT_DIR=/data/journal-import
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=10
# NAS 生产环境请改成绝对路径，例如 /volume1/docker/task-platform/data/postgres。
POSTGRES_DATA_PATH=./data/postgres
UPLOAD_DATA_PATH=./data/uploads
JOURNAL_IMPORT_PATH=./data/journal-import
BACKUP_DATA_PATH=./data/backups

# 仅开发/测试 seed 使用；生产环境不会自动 seed。
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=ChangeMe123!
